# Mail transport for the enquiry forms (/send-mail.php and /form-handler.php).
# With SMTP_HOST set, mail goes through SMTP. Without it, on Linux the local sendmail binary is
# used (what PHP mail() used). On localhost with no working transport, send-mail logs to
# mail_log.txt and answers "success", exactly like the PHP version.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Values that were hard-coded in send-mail.php / form-handler.php (these are the defaults).
MAIL_TO=info@autologicindustries.com
MAIL_SITE_NAME=Autologic Industries
MAIL_BCC=anandkpp123@gmail.com, promopactmarketing@gmail.com
# Empty = noreply@<request host>
MAIL_FROM=
WHATSAPP_NUMBER=919999985012
